// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "flexbox_cg_gha_dab",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:debian",
	"mounts": [
		// IMPORTANT! your container will fail to start if the path in your WSL does not exist!
		// use git credentials from the host wsl
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind",
		//use databricks credentials from the host wsl
		//"source=${localEnv:HOME}${localEnv:USERPROFILE}/.databrickscfg,target=/home/vscode/.databrickscfg,type=bind",
		//use uv config/credentials from the host wsl
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.local/share/uv,target=/home/vscode/.local/share/uv,type=bind"
	],
	"runArgs": ["--name", "flexbox_cg_gha_dab"],
	"features": {
		"./de-cf-devcontainer-features/src/pg-certs": {},
		// you don't actually need python if you have uv
		"ghcr.io/devcontainers/features/python:1": {"version": "3.12" },
		"ghcr.io/kingbain/devcontainer-features-databricks/databricks-cli:0":{},
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1":{},
		"ghcr.io/jsburckhardt/devcontainer-features/ruff:1":{}
		//"ghcr.io/devcontainers/features/copilot-cli:1":{},
		//"ghcr.io/jsburckhardt/devcontainer-features/opencode:1":{},
		//"ghcr.io/devcontainers-extra/features/jira-cli:1":{}
		//"ghcr.io/iambipinpaul/devcontainer-features/oh-my-posh:1":{
		//	"theme": "https://github.com/JanDeDobbeleer/oh-my-posh/blob/main/themes/catppuccin.omp.json"  //the best theme.  You're welcome to disagree, but you're wrong.
		//},
		//"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		//"ghcr.io/devcontainers-extra/features/node-asdf:0":{}
	},
	"overrideFeatureInstallOrder": [
		"./de-cf-devcontainer-features/src/pg-certs",
		"ghcr.io/devcontainers/features/python",
		"ghcr.io/kingbain/devcontainer-features-databricks/databricks-cli",
		"ghcr.io/devcontainers/features/azure-cli",
		"ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv",
		"ghcr.io/jsburckhardt/devcontainer-features/ruff"
		//"ghcr.io/devcontainers/features/copilot-cli",
		//"ghcr.io/iambipinpaul/devcontainer-features/oh-my-posh",
		//"ghcr.io/jsburckhardt/devcontainer-features/opencode",
		//"ghcr.io/devcontainers-extra/features/jira-cli",
		//"ghcr.io/devcontainers/features/docker-outside-of-docker",
		//"ghcr.io/devcontainers-extra/features/node-asdf"
	],
	"containerEnv":{
		"NODE_OPTIONS": "--use-openssl-ca",
		"REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt",
		"CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
		"UV_SYSTEM_CERTS": "true",
		"DATABRICKS_HOST": "adb-1111111111111110.10.azuredatabricks.net"
	},
	"remoteEnv":{
		"NODE_OPTIONS": "--use-openssl-ca",
		"REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt",
		"CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
		"UV_SYSTEM_CERTS": "true",
		"DATABRICKS_HOST": "adb-1111111111111110.10.azuredatabricks.net"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"http.proxyStrictSSL": false
			},
			"extensions": [
				"njpwerner.autodocstring",
				"databricks.databricks",
				"tamasfe.even-better-toml",
				"github.vscode-github-actions",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.mypy-type-checker",
				"SonarSource.sonarlint-vscode",
				//"mtxr.sqltools",
				"dorzey.vscode-sqlfluff",
				"redhat.vscode-yaml",
				"charliermarsh.ruff",
				"JFrog.jfrog-vscode-extension",
				"bierner.markdown-mermaid"
			]
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/post-create.sh",
	"initializeCommand": "./.devcontainer/init-host.sh"
	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
